
Options -Indexes

RewriteEngine On

# GitHub OAuth callback
RewriteRule ^callback/?$ index.php?route=callback [QSA,L]

# Start GitHub login
RewriteRule ^login/?$ index.php?route=login [QSA,L]

# Protect sensitive files
<FilesMatch "^(config\.php|\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Security headers (same set as rabsrabi.com) and keep the admin out of search results
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
